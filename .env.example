# Template for .env — copy this to .env in the repo root, fill it in, then run
# `dotfiles sync config` to symlink it to ~/.env (setup/zsh is what sources that
# from ~/.zshrc). .env itself is git-ignored; this file is not, so never put a
# real secret here.

# Premium licence key for the intelephense PHP language server, which mason
# installs on the desktop profile. Leave empty to run intelephense unlicensed.
INTELEPHENSE_LICENSE=
