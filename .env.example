# Template for .env — copy this to .env in the repo root, fill it in, then run
# `dotfiles link-config` to symlink it to ~/.env (src/install-zsh is what
# sources that from ~/.zshrc). .env itself is git-ignored; this file is not, so
# never put a real secret here.
#
# Every value needs `export`: nvim reads these from its environment, and a bare
# assignment sourced by ~/.zshrc is a shell variable, not an exported one.

# Which profile this machine is: 'desktop' for a full dev environment, 'tty'
# for a server running zsh and nvim as a plain editor. Read by the dotfiles
# scripts and by config/nvim/lua/user/profile.lua.
export DOTFILES_PROFILE=desktop

# Premium licence key for the intelephense PHP language server, which mason
# installs on the desktop profile. Leave empty to run intelephense unlicensed.
export INTELEPHENSE_LICENSE=
