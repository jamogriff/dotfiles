#!/usr/bin/env bash
#
# dotfiles — single entrypoint for every setup script in this repo.
#
# Usage: dotfiles <command> [target]
#
# Three command families, deliberately kept separate:
#   bootstrap   one-time (or rare) setup: the full desktop/tty sequence, and
#               the heavy desktop-only language-runtime install on its own.
#   install     piecewise, idempotent installs of third-party software.
#   sync        reconcile this machine's symlinks against what the repo
#               currently says. Its own family rather than an `install`
#               subcommand because it installs nothing.
#
# Run with no arguments, or "help", to see the full command list.

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

usage() {
  cat <<EOF
Usage: dotfiles <command> [target]

Bootstrap (one-time; pick the one matching the machine):
  bootstrap desktop         full desktop setup: packages, zsh, languages,
                            terminal, config, nvim
  bootstrap tty             full tty setup: packages, zsh, config, nvim
                            (no languages, no terminal — see README)

Install (piecewise; re-run any time):
  install terminal          install the Kitty terminal (desktop only)
  install nvim              install the Neovim AppImage

Sync (reconcile symlinks; re-run any time):
  sync config               symlink everything in config/ for whichever
                            profile this machine was bootstrapped with

  help                      show this message

Examples:
  dotfiles bootstrap desktop
  dotfiles sync config
EOF
}

# --- one function per real script already in this repo ---

# Not exposed as `install` subcommands: both are one-time steps that only run
# as part of `bootstrap`. Re-running either by hand is a no-op at best (the
# apt package list) or risks re-tripping install-time branching (oh-my-zsh,
# the default-shell switch), so the functions stay internal to bootstrap.
install_packages() {
  echo "==> Installing shared OS packages"
  bash "$DOTFILES_DIR/setup/packages"
}

install_zsh() {
  echo "==> Installing zsh + oh-my-zsh"
  bash "$DOTFILES_DIR/setup/zsh"
}

install_terminal() {
  echo "==> Installing Kitty terminal (desktop only)"
  bash "$DOTFILES_DIR/setup/desktop/terminal"
}

# The profile this machine was bootstrapped with, from the ~/.dotfiles-profile
# marker setup/desktop/config and setup/tty/config write. Same file
# config/nvim/lua/user/profile.lua reads, so `sync config` and the editor can
# never disagree about which profile this machine is.
#
# Unlike profile.lua, a missing or unrecognized file is an error rather than a
# silent fall back to desktop: the editor only loses a few plugins by guessing
# wrong, but this would symlink a desktop config (kitty, fonts) onto a tty box.
current_profile() {
  local profile_file="$HOME/.dotfiles-profile"

  if [ ! -f "$profile_file" ]; then
    echo "sync config: no $profile_file — this machine hasn't been bootstrapped yet. Run 'dotfiles bootstrap desktop' or 'dotfiles bootstrap tty' first." >&2
    return 1
  fi

  local profile
  profile="$(cat "$profile_file")"
  case "$profile" in
    desktop|tty) echo "$profile" ;;
    *)
      echo "sync config: $profile_file says '$profile', which isn't 'desktop' or 'tty'. Fix that file, or re-run 'dotfiles bootstrap <profile>'." >&2
      return 1
      ;;
  esac
}

# Named for what it does: after the first run it reconciles existing symlinks
# against what the repo currently says rather than installing anything. Worth
# re-running whenever a new file appears under config/, a source path moves, a
# conditional target like .env finally exists, or something clobbered a symlink.
#
# Still takes the profile as an argument rather than calling current_profile
# itself: bootstrap runs this *before* the marker file it reads exists, and
# already knows the target from the command line.
sync_config() {
  local target="$1"
  case "$target" in
    desktop|tty) ;;
    *)
      echo "sync config: target must be 'desktop' or 'tty', got '$target'" >&2
      return 1
      ;;
  esac

  echo "==> Syncing config symlinks ($target profile)"
  bash "$DOTFILES_DIR/setup/$target/config"
}

install_nvim() {
  echo "==> Installing Neovim"
  bash "$DOTFILES_DIR/setup/nvim"
}

# Desktop-only and heavy (a from-source Ruby build), and not reachable as a
# command of its own: this runs exactly once, as part of `bootstrap desktop`,
# to give a fresh machine the runtimes mason's LSPs need. After that, installing
# or switching a language version is nvm/rbenv/uv's job directly — this repo
# has no reason to wrap it.
bootstrap_languages() {
  echo "==> Bootstrapping language runtimes (desktop only)"
  bash "$DOTFILES_DIR/setup/desktop/bootstrap-languages"
}

bootstrap() {
  local target="$1"
  case "$target" in
    desktop|tty) ;;
    *)
      echo "bootstrap: target must be 'desktop' or 'tty', got '$target'" >&2
      return 1
      ;;
  esac

  install_packages
  install_zsh
  case "$target" in
    desktop)
      bootstrap_languages
      install_terminal
      sync_config desktop
      ;;
    tty)
      sync_config tty
      ;;
  esac
  install_nvim
  echo "==> $target bootstrap complete. Launch nvim to bootstrap plugins/LSPs."
}

# --- argument parsing / dispatch ---

cmd="${1:-help}"
sub="${2:-}"

case "$cmd" in
  bootstrap)
    case "$sub" in
      desktop|tty) bootstrap "$sub" ;;
      *)
        echo "Unknown bootstrap target: '$sub'" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  install)
    case "$sub" in
      terminal) install_terminal ;;
      nvim)     install_nvim ;;
      config)
        # Pointed at rather than quietly aliased: this was the spelling until
        # config symlinking moved out of the install family, so a bare "Unknown
        # install target" would read as the command having been dropped.
        echo "install config: renamed — it installs nothing. Use 'dotfiles sync config'." >&2
        exit 1
        ;;
      *)
        echo "Unknown install target: '$sub'" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  sync)
    case "$sub" in
      config)
        # Rejected rather than ignored: `sync config desktop` mirrors the old
        # `install config desktop` spelling, so silently accepting it would look
        # like it still picks the profile when the marker file is what actually
        # decides now.
        if [ -n "${3:-}" ]; then
          echo "sync config: takes no target — the profile comes from ~/.dotfiles-profile (got '$3')" >&2
          exit 1
        fi
        profile="$(current_profile)" || exit 1
        sync_config "$profile"
        ;;
      *)
        echo "Unknown sync target: '$sub'" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: '$cmd'" >&2
    usage
    exit 1
    ;;
esac
