#!/usr/bin/env bash
set -e

if ! command -v zsh >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y zsh
fi

ZSH_BIN="$(command -v zsh)" || {
  echo "zsh isn't on PATH even after attempting to install it; something above failed silently. Check the apt-get output." >&2
  exit 1
}

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  # KEEP_ZSHRC: without it the installer *moves* ~/.zshrc aside and drops in its
  # own template, silently losing the nvm/rbenv/uv init lines already there (zsh
  # doesn't read ~/.profile, so those tools would just vanish). It also stops on
  # a [Y/n] prompt without the flag, hanging an unattended bootstrap.
  #
  # The tradeoff: the installer then never writes the lines that *load*
  # oh-my-zsh, so we append them ourselves below.
  # RUNZSH=no/CHSH=no: this script handles the shell switch itself.
  KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "oh-my-zsh already installed at ~/.oh-my-zsh, skipping."
fi

# Goes in as one block because `plugins=` and ZSH_THEME both have to be assigned
# before oh-my-zsh.sh runs. An empty ZSH_THEME gets you an unthemed prompt, which
# looks identical to the install having failed.
if ! grep -qF 'oh-my-zsh.sh' "$HOME/.zshrc" 2>/dev/null; then
  cat >>"$HOME/.zshrc" <<'EOF'

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker-compose docker)
source $ZSH/oh-my-zsh.sh
EOF
  echo "Added the oh-my-zsh bootstrap block to ~/.zshrc."
else
  echo "oh-my-zsh already sourced from ~/.zshrc, skipping."
fi

# Sources the ~/.env symlink setup/desktop/config creates. Last, so anything
# exported there wins over the version managers and oh-my-zsh above it.
#
# This block was spelled ~/.local/.secrets before the config/ reorganization; the
# grep won't match that older one, so an already-bootstrapped machine ends up
# with both. See the README's migration notes for removing the dead one.
if ! grep -qF 'source $HOME/.env' "$HOME/.zshrc" 2>/dev/null; then
  cat >>"$HOME/.zshrc" <<'EOF'

if [ -f $HOME/.env ]; then
    source $HOME/.env
else
    echo 'WARNING: No .env file found'
fi
EOF
else
  echo ".env sourcing already present in ~/.zshrc, skipping."
fi

# Fallback for a ~/.zshrc that got oh-my-zsh's template some other way — a no-op
# on a clean run. Edited in place rather than appended, since `plugins=` only
# takes effect before oh-my-zsh.sh is sourced. An already-customized line is left
# alone rather than risk mangling it.
if grep -qx 'plugins=(git)' "$HOME/.zshrc" 2>/dev/null; then
  sed -i 's/^plugins=(git)$/plugins=(git docker-compose docker)/' "$HOME/.zshrc"
  echo "Added docker/docker-compose to ~/.zshrc's oh-my-zsh plugins."
else
  echo "~/.zshrc's plugins= line isn't the fresh-install default; leaving it as-is (add docker/docker-compose yourself if you want them)."
fi

CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$CURRENT_SHELL" != "$ZSH_BIN" ]; then
  if grep -qx "$ZSH_BIN" /etc/shells; then
    sudo chsh -s "$ZSH_BIN" "$USER"
  else
    echo "warning: $ZSH_BIN not listed in /etc/shells; add it, then re-run this script." >&2
    exit 1
  fi
else
  echo "Default shell is already $ZSH_BIN, skipping."
fi
