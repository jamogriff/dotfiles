#!/usr/bin/env bash
set -e

# Idempotent: safe to re-run. Skips the oh-my-zsh install if ~/.oh-my-zsh already
# exists (its own installer isn't idempotent — it errors out if that dir is there),
# and skips the shell switch if zsh is already the default shell.

if ! command -v zsh >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y zsh
fi

ZSH_BIN="$(command -v zsh)" || {
  echo "zsh isn't on PATH even after attempting to install it; something above failed silently. Check the apt-get output." >&2
  exit 1
}

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  # KEEP_ZSHRC: leave any existing ~/.zshrc completely alone. Without this the
  # installer *moves* it to ~/.zshrc.pre-oh-my-zsh and drops its own template in
  # place — and since setup/packages runs before this script, that file already
  # holds the nvm/rbenv/uv init lines those installers appended. Losing them is
  # silent: zsh doesn't read ~/.profile, so those tools would simply vanish from
  # interactive zsh. (Dropping the flag would also make the installer stop on a
  # [Y/n] overwrite prompt, hanging an unattended `dotfiles bootstrap`.)
  #
  # The tradeoff is that the installer then never writes the lines that actually
  # *load* oh-my-zsh, so we append them ourselves just below.
  # RUNZSH=no/CHSH=no: this script handles the shell switch itself, below.
  KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "oh-my-zsh already installed at ~/.oh-my-zsh, skipping."
fi

# Load oh-my-zsh. KEEP_ZSHRC above means the installer left ~/.zshrc untouched, so
# without this block ~/.oh-my-zsh sits on disk fully installed and never gets
# sourced — you get a bare zsh prompt and no `omz` command, which looks exactly
# like the install having failed.
#
# ZSH_THEME matters: oh-my-zsh.sh only sources a theme if the variable is
# non-empty, so leaving it unset gives you an unthemed prompt — the same symptom.
# `plugins=` has to be assigned before oh-my-zsh.sh runs, which is why the whole
# thing goes in as one block rather than being appended piecemeal.
if ! grep -qF 'oh-my-zsh.sh' "$HOME/.zshrc" 2>/dev/null; then
  cat >>"$HOME/.zshrc" <<'EOF'

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker-compose docker)
source $ZSH/oh-my-zsh.sh
EOF
  echo "Added the oh-my-zsh bootstrap block to ~/.zshrc."
else
  echo "oh-my-zsh already sourced from ~/.zshrc, skipping."
fi

# Source the .secrets symlink setup/desktop/config sets up at ~/.local/.secrets (env vars
# like INTELEPHENSE_LICENSE). Goes in last so anything exported there wins over
# whatever the version managers or oh-my-zsh put on PATH above it.
if ! grep -qF '.local/.secrets' "$HOME/.zshrc" 2>/dev/null; then
  cat >>"$HOME/.zshrc" <<'EOF'

if [ -f $HOME/.local/.secrets ]; then
    source $HOME/.local/.secrets
else
    echo 'WARNING: No secrets file found'
fi
EOF
else
  echo ".secrets sourcing already present in ~/.zshrc, skipping."
fi

# Fallback for a ~/.zshrc that got oh-my-zsh's own template some other way (an
# earlier manual install, say) — the block above writes the right plugins itself,
# so on a clean run this is a no-op. Only touches the line if it's still the
# untouched fresh-install default (plugins=(git))
# — the `plugins=` assignment has to run before `source $ZSH/oh-my-zsh.sh` to have any
# effect, so this can't just be appended to the end of the file like the block above,
# and an already-customized line is left alone rather than risk mangling it.
if grep -qx 'plugins=(git)' "$HOME/.zshrc" 2>/dev/null; then
  sed -i 's/^plugins=(git)$/plugins=(git docker-compose docker)/' "$HOME/.zshrc"
  echo "Added docker/docker-compose to ~/.zshrc's oh-my-zsh plugins."
else
  echo "~/.zshrc's plugins= line isn't the fresh-install default; leaving it as-is (add docker/docker-compose yourself if you want them)."
fi

CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$CURRENT_SHELL" != "$ZSH_BIN" ]; then
  if grep -qx "$ZSH_BIN" /etc/shells; then
    sudo chsh -s "$ZSH_BIN" "$USER"
  else
    echo "warning: $ZSH_BIN not listed in /etc/shells; add it, then re-run this script." >&2
    exit 1
  fi
else
  echo "Default shell is already $ZSH_BIN, skipping."
fi
