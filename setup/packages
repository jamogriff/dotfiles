#!/usr/bin/env bash
set -e

# OS-level prerequisites shared by both profiles. zsh has its own step
# (setup/zsh) since installing it is only half the job; desktop-only dev tooling
# lives in setup/desktop/bootstrap-languages.
PACKAGES=(xclip tmux curl unzip fzf ripgrep)

sudo apt-get update
sudo apt-get install -y "${PACKAGES[@]}"
