#!/usr/bin/env bash

INIT_SCRIPT_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
DOTFILES="${INIT_SCRIPT_DIR}/../.."

source "$DOTFILES/setup/lib/config.bash"

# setup/desktop/config's list minus the desktop-only entries (kitty, .ideavimrc).
for name in .gitconfig .tmux.conf nvim; do
    link_config "$name"
done

link_bin t
# Not on desktop: this drives an external display from a headless session.
link_bin mac_display

echo tty > "$HOME/.dotfiles-profile"

link_zsh_custom
