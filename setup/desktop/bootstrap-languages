#!/usr/bin/env bash
set -e

# Installs the language runtimes mason.nvim's LSPs rely on: Node (nvm), Ruby
# (rbenv), and the uv tool for Python. Desktop-only, since LSPs only run in a
# desktop dev session (nvim/lua/user/plugins.lua's is_tty() gate skips
# mason/lspconfig entirely on tty) -- a lightweight server has no use for a C
# toolchain and a from-source Ruby build.
#
# This is a *bootstrap* step, not a piecewise `install` one: re-running it
# means recompiling Ruby if the pinned version below changed (several minutes,
# vs. a quick config tweak), so it only runs as part of `dotfiles bootstrap
# desktop`. To pick up a version bump later without repeating the whole
# bootstrap, edit NODE_VERSION/RUBY_VERSION below and run
# `dotfiles bootstrap languages` on its own.

# ruby-build compiles Ruby from source rather than downloading a binary, so rbenv
# needs a C toolchain plus the headers Ruby links against. Miss one and `rbenv
# install` dies partway through a compile with an error that doesn't obviously
# point back to a missing package. Names are the Ubuntu/Debian ones (this targets
# Pop!_OS 24.04 noble); see the ruby-build wiki for other distros. `rustc` is what
# lets Ruby 3.2+ build YJIT — drop it if you'd rather not pull in the toolchain.
RUBY_BUILD_DEPS=(
  autoconf patch build-essential rustc libssl-dev zlib1g-dev libyaml-dev
  libreadline-dev libncurses-dev libffi-dev libgdbm-dev libdb-dev uuid-dev
)

# Language runtimes to install. Pinned rather than floating so every machine set up
# from this repo lands on the same versions.
NODE_VERSION=24        # nvm resolves this to the latest 24.x
RUBY_VERSION=3.3.5

sudo apt-get update
sudo apt-get install -y "${RUBY_BUILD_DEPS[@]}"

# Language runtime version managers, so mason.nvim has a Node/Ruby/Python to install
# LSPs with. Each installer is self-idempotent (safe to re-run; updates an existing
# install in place) and wires itself into your shell rc file automatically.
#
# Note they all detect *bash* and write their init snippet to ~/.bashrc, because
# that's the shell running this script — zsh gets the same wiring from
# zsh/version-managers.zsh, which setup/desktop/config symlinks into $ZSH_CUSTOM.

# nvm (Node) — https://github.com/nvm-sh/nvm
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash

# rbenv + ruby-build (Ruby) — https://rbenv.org
curl -fsSL https://rbenv.org/install.sh | bash

# uv (Python) — https://docs.astral.sh/uv
curl -LsSf https://astral.sh/uv/0.12.9/install.sh | sh

# --- language runtimes ---
#
# Each install is guarded so a re-run doesn't re-download a toolchain that's
# already on disk — that matters most for Ruby, where a rebuild is several
# minutes of compilation rather than a quick unpack.
#
# The version managers were only just installed above, so none of them are on this
# shell's PATH yet (the rc-file snippets they wrote won't apply until a new shell).
# Each block therefore loads or addresses its manager by absolute path.

# Node. nvm is a shell function, not a binary, so it has to be sourced. Guard on
# `nvm version`, which prints the resolved version or the literal "N/A" — unlike
# `nvm ls`, which exits 0 whether or not the version is present.
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
if [ "$(nvm version "$NODE_VERSION")" = "N/A" ]; then
  nvm install "$NODE_VERSION"
else
  echo "Node $(nvm version "$NODE_VERSION") already installed, skipping."
fi
# Make it the version new shells get, otherwise the install is inert.
nvm alias default "$NODE_VERSION"

# Ruby. `rbenv versions --bare` lists exactly the installed versions, one per line,
# so grep -x is an exact match rather than a prefix one (3.3.5 vs 3.3.50).
RBENV="$HOME/.rbenv/bin/rbenv"
if "$RBENV" versions --bare | grep -qx "$RUBY_VERSION"; then
  echo "Ruby $RUBY_VERSION already installed, skipping."
else
  "$RBENV" install "$RUBY_VERSION"
fi
# Without this `ruby` stays on the system version and the install has no effect.
"$RBENV" global "$RUBY_VERSION"
