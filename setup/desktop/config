#!/usr/bin/env bash

INIT_SCRIPT_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
DOTFILES="${INIT_SCRIPT_DIR}/../.."

source "$DOTFILES/setup/lib/config.bash"

# kitty and .ideavimrc are the desktop-only entries. link_config works out where
# each lands from its shape; see setup/lib/config.bash.
for name in .gitconfig .ideavimrc .tmux.conf kitty nvim; do
    link_config "$name"
done

# Fonts are unzipped, not symlinked — the repo tracks the vendor's .zip and
# ~/.fonts wants the font files themselves. The trailing rm cleans up the nested
# directory unzip leaves inside the repo.
rm -rf $HOME/.fonts
cd $DOTFILES/fonts
unzip "*.zip" "*.ttf" "*.otf" -d $HOME/.fonts
rm -rf $DOTFILES/fonts/*/

link_bin t

echo desktop > "$HOME/.dotfiles-profile"

link_zsh_custom

# Hand-written rather than driven by link_config: ~/.env isn't the identity
# mapping flat config/ entries use, and .env is git-ignored so a fresh clone
# doesn't have one. setup/zsh is what sources it from ~/.zshrc.
if [ -f $DOTFILES/.env ]; then
    rm -f $HOME/.env
    ln -s $DOTFILES/.env $HOME/.env
    echo "Linked $HOME/.env -> $DOTFILES/.env"
else
    echo 'WARNING: no .env in the repo root; copy .env.example to .env to set machine-specific env vars'
fi
