#!/usr/bin/env bash
# Stand-in for curl: nothing here ever touches the network.
#
# Most call sites pipe curl's stdout straight into `bash`/`sh` (the
# nvm/rbenv/uv installers). Printing nothing means that shell gets empty input
# and exits 0 immediately; whether those installers "ran" is answered by
# fixtures being in place, not by what curl did. oh-my-zsh's installer is the
# exception below — its side effect (writing ~/.zshrc) is itself under test.
#
# The two download forms do need a file to exist afterwards, so they fake one.
echo "curl $*" >> "$MOCK_LOG"

args=("$@")
for i in "${!args[@]}"; do
  case "${args[$i]}" in
    # `curl -fsSL <url>` piped into `sh -c` by install-zsh — the one piped
    # install that's actually asserted on, so it gets a real fixture script
    # rather than the empty-output default the rest fall through to.
    *ohmyzsh*install.sh*)
      cat "$MOCKS_DIR/../fixtures/oh-my-zsh/install.sh"
      exit 0
      ;;
    # `curl -fsSL <url>` captured into a variable and handed to `bash -c` by
    # install-homebrew, which then checks that brew exists -- so the stand-in
    # installer's one job is to plant it where find_brew looks.
    *Homebrew/install*install.sh)
      cat <<'INSTALLER'
mkdir -p "$BREW_ROOT/opt/homebrew/bin"
printf '#!/usr/bin/env bash\n' > "$BREW_ROOT/opt/homebrew/bin/brew"
chmod +x "$BREW_ROOT/opt/homebrew/bin/brew"
INSTALLER
      exit 0
      ;;
    # `curl -fsSL <url> | gunzip` — install-nvim's tree-sitter CLI. Emits a
    # gzipped stand-in that answers --version like the real binary.
    *tree-sitter-linux-x64.gz)
      printf '#!/usr/bin/env bash\necho "tree-sitter 0.27.0"\n' | gzip
      exit 0
      ;;
    # `curl ... -o <path>` — install-docker's GPG key fetch.
    -o)
      : > "${args[$((i + 1))]}"
      exit 0
      ;;
    # `curl -LO <url>` — install-nvim's AppImage. The stand-in only has to
    # answer --appimage-extract the way a real AppImage does.
    *.appimage)
      out="$(basename "${args[$i]}")"
      cat > "$out" <<'APPIMAGE'
#!/usr/bin/env bash
mkdir -p squashfs-root
printf '#!/usr/bin/env bash\necho "NVIM v0.12.5"\n' > squashfs-root/AppRun
chmod +x squashfs-root/AppRun
APPIMAGE
      chmod +x "$out"
      exit 0
      ;;
  esac
done
