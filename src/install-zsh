#!/usr/bin/env bash
# Installs zsh + oh-my-zsh and makes zsh the login shell.
# Run by bootstrap on desktop and tty.
#
# ~/.zshrc itself is disposable: it's written by the oh-my-zsh installer when installed.
# Anything durable belongs in config/zsh/custom.zsh instead

set -euo pipefail

if ! command -v zsh >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y zsh
fi

ZSH_BIN="$(command -v zsh)" || {
  echo "zsh isn't on PATH even after attempting to install it; something above failed silently. Check the apt-get output." >&2
  exit 1
}

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  # RUNZSH=no/CHSH=no: this script handles the shell switch itself.
  RUNZSH=no CHSH=no sh -c \
    "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "oh-my-zsh already installed at ~/.oh-my-zsh, skipping."
fi

CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$CURRENT_SHELL" != "$ZSH_BIN" ]; then
  if grep -qx "$ZSH_BIN" /etc/shells; then
    sudo chsh -s "$ZSH_BIN" "$USER"
  else
    echo "warning: $ZSH_BIN not listed in /etc/shells; add it, then re-run this script." >&2
    exit 1
  fi
else
  echo "Default shell is already $ZSH_BIN, skipping."
fi
