#!/usr/bin/env bash
# Installs the IBM Plex Mono Nerd Font: on Linux into ~/.fonts from the
# upstream nerd-fonts release, on macOS as the brew cask. Run by bootstrap on
# desktop only.
# Safe to re-run: skips everything if ~/.fonts already reports $FONT_VERSION
# (Linux) or the cask is already installed (macOS).
#
# Manual steps (Linux; macOS is `brew install --cask font-blex-mono-nerd-font`):
#   1. curl -L -o /tmp/IBMPlexMono.zip <FONT_URL>
#   2. rm -rf ~/.fonts
#   3. unzip /tmp/IBMPlexMono.zip 'BlexMonoNerdFontMono-*.ttf' -d ~/.fonts
#   4. fc-cache -f ~/.fonts
#
# Fetches: https://github.com/ryanoasis/nerd-fonts/releases/download/$FONT_VERSION/IBMPlexMono.zip
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "$DOTFILES_DIR/src/lib/versions.bash"
source "$DOTFILES_DIR/src/lib/platform.bash"

resolve_os
if [ "$DOTFILES_OS" = macos ]; then
  ensure_brew_on_path
  CASK=font-blex-mono-nerd-font
  if brew list --cask "$CASK" >/dev/null 2>&1; then
    echo "$CASK already installed, skipping."
  else
    brew install --cask "$CASK"
  fi

  # The cask owns ~/Library/Fonts; this only looks, and never runs the rm -rf
  # below. The file names carry the family kitty.conf asks for, "BlexMono Nerd
  # Font Mono", so their presence is what says the font is usable.
  if ls "$HOME"/Library/Fonts/BlexMonoNerdFontMono-*.ttf >/dev/null 2>&1; then
    echo "✅ IBM Plex Mono Nerd Font installed to ~/Library/Fonts."
  else
    echo "warning: no BlexMonoNerdFontMono-*.ttf in ~/Library/Fonts; kitty.conf's 'BlexMono Nerd Font Mono' won't resolve. Check 'brew list --cask $CASK'." >&2
  fi
  exit 0
fi

FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/$FONT_VERSION/IBMPlexMono.zip"
FONTS_DIR="$HOME/.fonts"
# kitty is the only consumer and wants the Mono variant; the archive also
# carries NerdFont and NerdFontPropo faces nothing here asks for.
FONT_GLOB='BlexMonoNerdFontMono-*.ttf'
# The faces carry no version anywhere fontconfig can read, so the install
# stamps one. Its absence is also what reinstalls over a pre-v3 ~/.fonts.
VERSION_FILE="$FONTS_DIR/.nerd-font-version"

if [ -f "$VERSION_FILE" ] && [ "$(cat "$VERSION_FILE")" = "$FONT_VERSION" ]; then
  echo "Nerd Font $FONT_VERSION already installed, skipping."
  exit 0
fi

# A temp dir rather than the repo: the archive is upstream's, not ours, and
# has no business in the working tree.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -L -o "$tmp/IBMPlexMono.zip" "$FONT_URL"

# Wiped rather than merged: v2 named its faces entirely differently, so the
# stale ones would sit alongside the new set forever.
rm -rf "$FONTS_DIR"
unzip "$tmp/IBMPlexMono.zip" "$FONT_GLOB" -d "$FONTS_DIR"
echo "$FONT_VERSION" > "$VERSION_FILE"

fc-cache -f "$FONTS_DIR"

echo "✅ IBM Plex Mono Nerd Font $FONT_VERSION installed to $FONTS_DIR."
