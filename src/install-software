#!/usr/bin/env bash
# apt-installs end-user applications for the desktop profile. Run by bootstrap
# on desktop only; tty has no GUI to put these in front of.
# Safe to re-run: it is one apt-get install, so a second run just re-checks.
#
# Manual steps:
#   1. sudo apt-get update
#   2. sudo apt-get install -y zathura zathura-pdf-poppler
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "$DOTFILES_DIR/src/lib/platform.bash"

resolve_os
if [ "$DOTFILES_OS" = macos ]; then
  echo "No PDF viewer is installed on macOS; Preview covers it. Skipping."
  exit 0
fi

# Applications live here; CLI substrate (xclip, fzf, ripgrep, tmux) belongs in
# src/install-packages instead.
PACKAGES=(zathura zathura-pdf-poppler)

pkg_install "${PACKAGES[@]}"
