#!/usr/bin/env bash
# Symlinks this repo's config/, scripts/ and .env into $HOME for
# $DOTFILES_PROFILE. Run by bootstrap on desktop and tty.
# Safe to re-run: every destination is replaced outright, so a second run is a
# no-op and a symlink someone overwrote with a real file gets repaired.
#
# Manual steps:
#   1. ln -s "$PWD/config/nvim" ~/.config/nvim        # a directory -> ~/.config/<name>
#   2. ln -s "$PWD/config/.gitconfig" ~/.gitconfig    # a file -> ~/<name>
#   3. ln -s "$PWD/scripts/t" ~/.local/bin/t          # desktop; mac_display on tty
#   4. ln -s "$PWD"/config/zsh/*.zsh ~/.oh-my-zsh/custom/   # file by file, not the dir
#   5. ln -s "$PWD/.env" ~/.env
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

source "$DOTFILES_DIR/src/lib/link.bash"
source "$DOTFILES_DIR/src/lib/profile.bash"

resolve_profile

# The whole "which names does each profile get" table, in one place.
case "$DOTFILES_PROFILE" in
  desktop)
    CONFIG_ENTRIES=(.gitconfig .ideavimrc .tmux.conf kitty nvim)
    BIN_ENTRIES=(t)
    ;;
  tty)
    CONFIG_ENTRIES=(.gitconfig nvim)
    # Not on desktop: this drives an external display from a headless session.
    BIN_ENTRIES=(mac_display)
    ;;
esac

for name in "${CONFIG_ENTRIES[@]}"; do
  link_config "$name"
done

for name in "${BIN_ENTRIES[@]}"; do
  link_bin "$name"
done

link_zsh_custom

# Hand-written rather than driven by link_config: ~/.env isn't the identity
# mapping flat config/ entries use, and .env is git-ignored so a fresh clone
# doesn't have one. install-zsh is what sources it from ~/.zshrc.
if [ -f "$DOTFILES_DIR/.env" ]; then
  rm -f "$HOME/.env"
  ln -s "$DOTFILES_DIR/.env" "$HOME/.env"
  echo "Linked $HOME/.env -> $DOTFILES_DIR/.env"
else
  echo 'WARNING: no .env in the repo root; copy .env.example to .env to set machine-specific env vars'
fi
