#!/usr/bin/env bash
# Installs nvm, rbenv and uv, plus a pinned Node and Python. Run by bootstrap
# on desktop only — plugins.lua's is_tty() gate skips mason/lspconfig entirely,
# so a tty box has no use for a C toolchain.
# Safe to re-run: each vendor installer is self-idempotent, and the Node and
# Python installs are guarded on the manager already reporting that version.
#
# Manual steps:
#   1. sudo apt-get install -y autoconf patch build-essential rustc libssl-dev \
#        zlib1g-dev libyaml-dev libreadline-dev libncurses-dev libffi-dev \
#        libgdbm-dev libdb-dev uuid-dev
#   2. curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash
#   3. curl -fsSL https://rbenv.org/install.sh | bash
#   4. curl -LsSf https://astral.sh/uv/0.12.9/install.sh | sh
#   5. nvm install 24 && nvm alias default 24
#   6. uv python install 3.14 --default && uv python pin --global 3.14
#
# No Ruby is built here — see the README. `rbenv install <version> && rbenv
# global <version>` is the one-liner, and it needs step 1 to have run.

# No -u: this sources the vendor's nvm.sh, which isn't written for it.
set -eo pipefail

# ruby-build compiles Ruby from source, so rbenv needs a C toolchain plus the
# headers Ruby links against — miss one and `rbenv install` dies partway through
# a compile with an error that doesn't point back at the missing package. Names
# are Ubuntu/Debian's (this targets Pop!_OS 24.04). `rustc` is what lets Ruby
# 3.2+ build YJIT.
RUBY_BUILD_DEPS=(
  autoconf patch build-essential rustc libssl-dev zlib1g-dev libyaml-dev
  libreadline-dev libncurses-dev libffi-dev libgdbm-dev libdb-dev uuid-dev
)

NODE_VERSION=24        # nvm resolves this to the latest 24.x
PYTHON_VERSION=3.14    # major.minor, so uv resolves the latest patch

sudo apt-get update
sudo apt-get install -y "${RUBY_BUILD_DEPS[@]}"

# Each installer is self-idempotent and wires itself into the rc file it detects
# — always ~/.bashrc, since this script runs under bash. zsh gets the same wiring
# from config/zsh/version-managers.zsh.

# nvm (Node) — https://github.com/nvm-sh/nvm
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | bash

# rbenv + ruby-build (Ruby) — https://rbenv.org
curl -fsSL https://rbenv.org/install.sh | bash

# uv (Python) — https://docs.astral.sh/uv
curl -LsSf https://astral.sh/uv/0.12.9/install.sh | sh

# The version managers aren't on this shell's PATH yet — the rc snippets they
# just wrote don't apply until a new shell — so each block below loads or
# addresses its manager by absolute path.

# nvm is a shell function, so it has to be sourced. Guard on `nvm version`, which
# prints "N/A" when absent; `nvm ls` exits 0 either way.
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
if [ "$(nvm version "$NODE_VERSION")" = "N/A" ]; then
  nvm install "$NODE_VERSION"
else
  echo "Node $(nvm version "$NODE_VERSION") already installed, skipping."
fi
# Make it the version new shells get, otherwise the install is inert.
nvm alias default "$NODE_VERSION"

# --default writes python/python3 shims into ~/.local/bin, which
# config/zsh/version-managers.zsh already puts on PATH; --global makes bare
# `uv run`/`uv venv` outside a project pick the same interpreter.
UV="$HOME/.local/bin/uv"
if "$UV" python find "$PYTHON_VERSION" >/dev/null 2>&1; then
  echo "Python $PYTHON_VERSION already installed, skipping."
else
  "$UV" python install "$PYTHON_VERSION" --default
  "$UV" python pin --global "$PYTHON_VERSION"
fi

cat <<MSG

Node $NODE_VERSION and Python $PYTHON_VERSION are on PATH in a new shell.
No Ruby was built: run 'rbenv install 3.4.1 && rbenv global 3.4.1' before
launching nvim, or mason's first-run install of ruby-lsp will fail.
MSG
